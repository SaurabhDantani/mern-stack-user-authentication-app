{
    "info": {
      "name": "MERN Stack Authentication API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Authentication",
        "item": [
          {
            "name": "Register User",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"name\": \"John Doe\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/auth/register",
                "host": ["{{base_url}}"],
                "path": ["auth", "register"]
              }
            }
          },
          {
            "name": "Login User",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/auth/login",
                "host": ["{{base_url}}"],
                "path": ["auth", "login"]
              }
            }
          },
          {
            "name": "Logout User",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/auth/logout",
                "host": ["{{base_url}}"],
                "path": ["auth", "logout"]
              }
            }
          }
        ]
      },
      {
        "name": "User Profile",
        "item": [
          {
            "name": "Get User Profile",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/user/profile",
                "host": ["{{base_url}}"],
                "path": ["user", "profile"]
              }
            }
          }
        ]
      },
      {
        "name": "Admin Routes",
        "item": [
          {
            "name": "Get All Users (Admin Only)",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/admin/users",
                "host": ["{{base_url}}"],
                "path": ["admin", "users"]
              }
            }
          },
          {
            "name": "Get Admin Dashboard",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/admin/dashboard",
                "host": ["{{base_url}}"],
                "path": ["admin", "dashboard"]
              }
            }
          },
          {
            "name": "Get Active Sessions",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/sessions/active",
                "host": ["{{base_url}}"],
                "path": ["sessions", "active"]
              }
            }
          },
          {
            "name": "Logout Specific Session",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/sessions/:sessionId/logout",
                "host": ["{{base_url}}"],
                "path": ["sessions", ":sessionId", "logout"]
              }
            }
          }
        ]
      }
    ],
    "variable": [
      {
        "key": "base_url",
        "value": "http://localhost:3000",
        "type": "string"
      },
      {
        "key": "token",
        "value": "your_jwt_token_here",
        "type": "string"
      }
    ]
  }